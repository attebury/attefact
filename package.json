{
  "name": "@attebury/attefact",
  "version": "0.1.7",
  "type": "module",
  "description": "Domain-agnostic evidence-pinning and rot-detection primitives. Schema + pure logic only -- no DB client, no framework, no consumer-specific fields. See docs/decisions/.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
